<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+：系统 SplashScreen 只认一种底色 + 一个图标（不认 layer-list 里的位图）。
         底色取开屏夜色，图标换成透明占位（开屏不出现 logo）；随后 Flutter 开屏页的
         同色渐变接上。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_night_mid</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
