# =============================================================
# 模板文件 — 实际值在 .env 里（.env 不入 git）
# 新成员/新机器复制：cp .env.example .env  然后填入真实值
# =============================================================

TUSHARE_TOKEN=PUT_YOUR_TUSHARE_TOKEN_HERE
TUSHARE_ENDPOINT=http://api.tushare.pro

DEEPSEEK_API_KEY=PUT_YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com

# NASA FIRMS 卫星火点（可选）—— 留空则相关工具返回空提示
# 免费申请：https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# =============================================================
# 埋点（可选）—— Umami：开源，自托管或用免费云额度
#
# 配置步骤（Umami 里没有「App」这种类型，一个 App 就是一个 website）：
#   1. 登录 https://cloud.umami.is → Websites → Add website
#   2. name 填「喜爱」；domain 随便写一个，它只用于展示和筛选（建议 app.xiai）
#   3. 保存后进这个网站的设置页，复制 Website ID（一串 UUID）
#   4. 填到下面 UMAMI_WEBSITE_ID
# 不需要往 App 里嵌 script.js：客户端是直接 POST {host}/api/send，
# 和 Umami 自己的脚本走同一个接口。
#
# 留空 UMAMI_WEBSITE_ID 则整个埋点服务是 no-op，不会向外部发任何请求。
# UMAMI_HOST 可指向自建实例（协议相同）。
#
# 免费额度（Hobby）：$0 / 10 万事件 / 月 / 1 个网站 / 留存 6 个月。
# 注意计费口径：每存 1 个自定义事件属性也算 1 个事件。
# =============================================================
UMAMI_HOST=https://cloud.umami.is
UMAMI_WEBSITE_ID=
